# ---------------------------------------------------------------------------
# Exemple de fichier de variables.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars est ignoré par git (.gitignore) : il peut contenir des
# valeurs propres à ton compte. Ce fichier .example, lui, est versionné et
# sert de documentation vivante.
#
# Toutes les valeurs ci-dessous sont les DÉFAUTS déclarés dans variables.tf.
# Ne décommente que ce que tu veux réellement changer.
# ---------------------------------------------------------------------------


# --- Identité -------------------------------------------------------------
# project_name = "aws-saa-manara"
# environment  = "dev"
# owner        = "manara-graduation"
# extra_tags   = { CostCenter = "training" }


# --- Région et AZ ---------------------------------------------------------
# region      = "eu-west-1"  # cf. ADR-002 : eu-west-3 exclue par le quota RDS "Free Plan"
# az_suffixes = ["a", "b"]


# --- Réseau ---------------------------------------------------------------
# vpc_cidr                  = "10.0.0.0/16"
# public_subnet_cidrs       = ["10.0.0.0/24", "10.0.1.0/24"]
# private_app_subnet_cidrs  = ["10.0.10.0/24", "10.0.11.0/24"]
# private_data_subnet_cidrs = ["10.0.20.0/24", "10.0.21.0/24"]


# --- Sortie Internet privée (cf. docs/adr/001-nat-mode-variable.md) -------
# Défaut = "instance" (~3 USD/mois) : profil économique. "gateway" (~32
# USD/mois) est le mode robuste attendu à l'examen, à activer pour la
# démonstration finale.
# nat_mode              = "instance"   # "gateway" | "instance" | "endpoints"
# nat_high_availability = false        # true = un NAT par AZ, double le coût
# nat_instance_type     = "t3.micro"   # utilisé si nat_mode = "instance" ; doit rester eligible free tier
# enable_ssm_endpoints  = false        # true = ~7,50 USD/mois/AZ/endpoint, cf. README networking


# --- Application (ALB + ASG) ----------------------------------------------
# Défaut = 1 instance (pas de redondance inter-AZ) : profil économique.
# instance_type              = "t3.micro"
# app_port                   = 8080
# asg_min_size               = 1
# asg_max_size               = 4
# asg_desired_capacity       = 1
# asg_target_cpu_utilization = 60
# alb_ingress_cidrs          = ["0.0.0.0/0"]
# enable_waf                 = false   # true = ~5 USD/mois + volumétrie


# --- Base de données ------------------------------------------------------
# db_instance_class        = "db.t4g.micro"
# db_engine_version        = "16.4"
# multi_az                 = false      # true pour démontrer la HA (coût x2)
# db_allocated_storage     = 20
# db_name                  = "appdb"
# db_username              = "appadmin"
# db_backup_retention_days = 1
# db_deletion_protection   = false      # NE PAS passer à true : casse `make destroy`


# --- Edge (S3 + CloudFront) -----------------------------------------------
# Défaut = false : une distribution CloudFront met ~15 min à se déployer et
# autant à détruire, ce qui ralentit chaque cycle apply/destroy en itération.
# enable_cloudfront      = false        # true pour la démonstration finale
# cloudfront_price_class = "PriceClass_100"
# s3_force_destroy       = true


# --- Observabilité et budget ----------------------------------------------
# À renseigner dans TON terraform.tfvars (non versionné) pour recevoir les
# alarmes : l'abonnement SNS doit ensuite être confirmé manuellement via le
# lien reçu par e-mail. Laisser vide désactive l'abonnement.
# alarm_email = "prenom.nom@example.com"

# log_retention_days         = 7
# budget_limit_usd           = 25
# budget_alert_thresholds    = [50, 80, 100]
# enable_detailed_monitoring = false


# ---------------------------------------------------------------------------
# Profils d'usage courants
# ---------------------------------------------------------------------------
#
# Économie maximale (= les défauts ci-dessus, ~26 USD/mois si laissé en
# marche un mois entier — cf. README « Coûts estimés ») :
#   nat_mode          = "instance"
#   enable_cloudfront = false
#   enable_waf        = false
#   asg_min_size         = 1
#   asg_desired_capacity = 1
#   multi_az          = false
#
# Démonstration de haute disponibilité (jury), ~135 USD/mois — à n'activer
# que pour une durée courte, puis `make destroy` :
#   nat_mode               = "gateway"
#   nat_high_availability  = true
#   multi_az               = true
#   asg_min_size            = 2
#   asg_desired_capacity    = 2
#   enable_waf              = true
#   enable_cloudfront       = true
# ---------------------------------------------------------------------------
